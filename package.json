{
  "name": "fmr-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": {
    "name": "Marcelo J Forclaz",
    "email": "marceloforclaz@gmail.com"
  },
  "scripts": {
    "start": "sh ./scripts/start.sh",
    "stop": "pm2 stop fmr-site",
    "build": "node ace build --package-manager=\"pnpm\"",
    "deploy": "sh ./scripts/deploy.sh",
    "dev": "node ace serve --watch",
    "test": "node ace test",
    "test:ui": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./app/types/*.js",
    "#utils/*": "./app/utils/*.js",
    "#actions/*": "./app/actions/*.js",
    "#helpers/*": "./app/helpers/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.2.3",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/api-client": "^3.0.3",
    "@japa/assert": "^2.1.0",
    "@japa/plugin-adonisjs": "^3.0.0",
    "@japa/runner": "^3.1.1",
    "@swc/core": "^1.4.16",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.30",
    "@types/pdfkit": "^0.14.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "happy-dom": "^14.12.3",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.1",
    "@adonisjs/cache": "^1.2.0",
    "@adonisjs/core": "^6.3.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/i18n": "^2.2.0",
    "@adonisjs/inertia": "1.0.0-23",
    "@adonisjs/lucid": "^20.5.1",
    "@adonisjs/mail": "^9.2.2",
    "@adonisjs/redis": "^9.2.0",
    "@adonisjs/session": "^7.3.0",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^3.0.0-11",
    "@inertiajs/vue3": "^1.0.15",
    "@round12/peach": "^0.0.5",
    "@vinejs/vine": "^1.8.0",
    "@vue/server-renderer": "^3.4.21",
    "@vueuse/core": "^10.11.0",
    "axios": "^1.7.9",
    "csv-parser": "^3.0.0",
    "edge.js": "^6.0.2",
    "i18next": "^24.2.1",
    "lodash-es": "^4.17.21",
    "luxon": "^3.4.4",
    "mysql2": "^3.9.4",
    "pdfkit": "^0.17.1",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.1",
    "resend": "^4.1.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.6",
    "vue": "^3.5.17",
    "zod": "^3.24.1",
    "zod-i18n-map": "^2.27.0"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.12.3"
}
